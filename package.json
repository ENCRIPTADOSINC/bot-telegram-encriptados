{
  "name": "bot-telegram-encriptados",
  "version": "1.0.0",
  "description": "Bot de Telegram para traduccion bidireccional en tiempo real",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "traducir": "tsx --env-file=.env src/cli.ts",
    "simulador": "tsx watch --env-file=.env src/simulator/server.ts",
    "escenarios": "tsx --env-file=.env src/scenarios.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.3.0",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
