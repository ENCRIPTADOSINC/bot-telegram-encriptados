# Copia este archivo como .env y completa los valores. Nunca subas .env a git.

# Clave de API de Claude (https://platform.claude.com -> API Keys)
ANTHROPIC_API_KEY=

# Modelo de Claude usado para traducir
CLAUDE_MODEL=claude-haiku-5-5

# Idioma en el que tú lees y escribes (código ISO 639-1)
OWNER_LANGUAGE=es

# Token del bot creado con @BotFather (necesario desde la Fase 2)
TELEGRAM_BOT_TOKEN=

# Chat donde llegan los mensajes de los clientes ya traducidos: tu chat privado con el bot
# o un grupo de agentes. Envía /miid al bot desde ese chat para obtener el número.
AGENT_CHAT_ID=
